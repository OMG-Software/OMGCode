{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": { "includes": ["**", "!dist", "!node_modules"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "error", "noDebugger": "error", "noConsole": "error" },
      "style": { "noNonNullAssertion": "error", "useImportType": "error" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
