{
  "name": "omgcode-desktop-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Webview frontend for the OMGCode desktop app. It renders untrusted content as text only.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:dist": "npm run build && vitest run tests/dist.test.ts",
    "tauri": "cd .. && tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@tauri-apps/cli": "2.12.5",
    "jsdom": "31.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
