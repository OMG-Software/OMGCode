{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Application commands for the main window only. No core permissions, no approval-decision commands, and no settings-window commands. The status bar may choose a model connection only through a native confirmation (ADR-0064).",
  "local": true,
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-app-info",
    "allow-session-tree",
    "allow-session-search",
    "allow-session-transcript",
    "allow-session-archive",
    "allow-session-restore",
    "allow-session-interrupt",
    "allow-workspace-list",
    "allow-session-create",
    "allow-chat-defaults",
    "allow-chat-send",
    "allow-chat-status",
    "allow-chat-cancel",
    "allow-chat-subscribe",
    "allow-approvals-summary",
    "allow-approvals-show-window",
    "allow-settings-show-window",
    "allow-settings-show-workspace",
    "allow-chat-preferences-save",
    "allow-session-skills",
    "allow-session-context",
    "allow-workspace-git-status",
    "allow-connection-status",
    "allow-connection-select",
    "allow-session-model-select",
    "allow-chat-models"
  ]
}
